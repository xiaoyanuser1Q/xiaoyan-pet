<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.0 兜底 (审计①): R8 shrink 保险。主保险是 PetPortrait.portraitResFor 的静态 when 映射;
     此文件按官方规范 (res/raw + 根元素 tools:keep 属性) 冗余保留, 防止未来改动 when 后立绘被删导致闪退。 -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/pet_neutral,@drawable/pet_happy,@drawable/pet_sad,@drawable/pet_angry,@drawable/pet_shy,@drawable/pet_surprised,@drawable/bg_*" />
